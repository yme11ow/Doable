<div id="<%= dom_id todo %>" class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-700 p-4">
  <div class="flex items-start justify-between">
    <div>
      <h3 class="text-lg font-medium text-gray-800 dark:text-gray-100"><%= link_to todo.name, todo_path(todo), class: "hover:underline text-indigo-600 dark:text-indigo-400" %></h3>
      <% if todo.description.present? %>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= todo.description %></p>
      <% end %>
    </div>
    <div class="text-right space-y-2">
      <% if todo.completed %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">Completed</span>
      <% end %>
      <div class="text-sm text-gray-500 dark:text-gray-400">Priority: <span class="font-semibold text-gray-700 dark:text-gray-300"><%= todo.priority %></span></div>
      <div class="text-sm text-gray-500 dark:text-gray-400"><%= link_to todo.project.name, project_path(todo.project), class: "text-indigo-600 dark:text-indigo-400 hover:underline" %></div>
    </div>
  </div>
</div>
