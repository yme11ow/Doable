<% content_for :title, "Todos" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold dark:text-white">Todos</h1>
  <%= link_to "New todo", new_todo_path, class: "bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600" %>
</div>

<div class="space-y-4">
  <% @todos.sort_by(&:priority).each do |todo| %>
    <%= render todo %>
  <% end %>
</div>
