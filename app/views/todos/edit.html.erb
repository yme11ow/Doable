<% content_for :title, "Editing todo" %>

<h1 class="text-2xl font-semibold dark:text-white mb-6">Editing Todo</h1>

<%= render "form", todo: @todo %>

<div class="mt-6 flex items-center space-x-3">
  <%= link_to "Show", @todo, class: "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-100 px-3 py-1 rounded hover:bg-gray-200 dark:hover:bg-gray-600" %>
  <%= link_to "Back to todos", todos_path, class: "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-100 px-3 py-1 rounded hover:bg-gray-200 dark:hover:bg-gray-600" %>
</div>
