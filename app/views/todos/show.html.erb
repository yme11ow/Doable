<%= render @todo %>

<div class="mt-6 flex items-center space-x-3">
  <%= link_to "Edit", edit_todo_path(@todo), class: "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-100 px-3 py-1 rounded hover:bg-gray-200 dark:hover:bg-gray-600" %>
  <%= link_to "Back to todos", todos_path, class: "bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-100 px-3 py-1 rounded hover:bg-gray-200 dark:hover:bg-gray-600" %>
  <%= button_to "Destroy", @todo, method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600 dark:bg-red-600 dark:hover:bg-red-700" %>
</div>
