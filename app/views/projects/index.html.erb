<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold dark:text-white">Projects</h1>
    <%= link_to "New project", new_project_path, class: "bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600" %>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% @projects.each do |project| %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 hover:shadow-lg transition">
            <div class="flex items-center justify-between">
                <%= link_to project.name, project_path(project), class: "text-lg font-medium text-gray-800 dark:text-gray-100 hover:text-indigo-600 dark:hover:text-indigo-400" %>
                <% unless project.active %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">Completed</span>
                <% end %>
            </div>
        </div>
    <% end %>
</div>