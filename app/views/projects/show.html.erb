<h1 class="text-3xl font-extrabold text-gray-900 dark:text-white mb-4"><%= @project.name %>
    <% unless @project.active %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">Completed</span>
    <% end %>    
</h1>

<ul class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-700 divide-y divide-gray-200 dark:divide-gray-700">
    <% @project.todos.each do |todo| %>
        <li class="flex items-center justify-between py-4 px-4 odd:bg-gray-50 dark:odd:bg-gray-700">
            <div class="flex items-center space-x-3">
                <%= link_to todo.name, todo_path(todo), class: "text-indigo-600 dark:text-indigo-400 hover:underline hover:text-indigo-700 dark:hover:text-indigo-300 text-lg font-medium" %>
                <% if todo.completed %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">Completed</span>
                <% end %>
            </div>
            <div class="text-sm text-gray-500 dark:text-gray-400">
                Priority: <span class="font-semibold text-gray-700 dark:text-gray-300"><%= todo.priority %></span>
            </div>
        </li>
    <% end %>
</ul>

<div class="mt-6 flex gap-2">
    <% if @project.active %>
        <%= button_to "Mark Complete", project_path(@project), method: :patch, params: { project: { active: false } }, class: "bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600 dark:bg-green-600 dark:hover:bg-green-700" %>
    <% else %>
        <%= button_to "Reactivate", project_path(@project), method: :patch, params: { project: { active: true } }, class: "bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600 dark:bg-red-600 dark:hover:bg-red-700" %>
    <% end %>
    <%= button_to "Delete Project", project_path(@project), method: :delete, class: "bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600 dark:bg-red-600 dark:hover:bg-red-700" %>
</div>



